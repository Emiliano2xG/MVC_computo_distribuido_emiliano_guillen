# Reverse proxy / API gateway + load balancer (nginx)
# Los upstreams se arman en caliente desde Consul (solo instancias healthy).
# Si una replica se registra o se da de baja, consul-template regenera este
# archivo y recarga nginx. Corre en su propio contenedor, entre el frontend
# (puerto 3000) y los servicios backend.
#
# Este archivo se renderiza a /etc/nginx/conf.d/default.conf (contexto http).

# ---------------------------------------------------------------------------
# Bitacora: incluye a que replica se mando cada peticion ($upstream_addr)
# ---------------------------------------------------------------------------
log_format gateway '$remote_addr [$time_local] "$request" $status '
                   'upstream=$upstream_addr upstream_status=$upstream_status '
                   'rt=$request_time urt=$upstream_response_time req_id=$request_id';

access_log /dev/stdout gateway;
error_log  /dev/stderr warn;

# ---------------------------------------------------------------------------
# Proteccion del gateway
#
# Rate limiting: cada IP puede hacer 50 peticiones por segundo sostenidas, con
# una rafaga de hasta 100 mas (ver `limit_req` en el server :8000). Pasando eso
# nginx responde 429 sin molestar a los backends. Evita que un cliente
# descontrolado (o un ataque simple) tumbe todo el sistema.
# La zona guarda el estado de ~160 mil IPs en 10 MB de memoria compartida.
# ---------------------------------------------------------------------------
# /heartbeat y /status quedan fuera: nginx no cuenta las peticiones cuya
# llave esta vacia (las usan el health check del contenedor y Prometheus).
map $request_uri $llave_limite {
    ~^/(heartbeat|status)$  "";
    default                 $binary_remote_addr;
}
limit_req_zone $llave_limite zone=api_por_ip:10m rate=50r/s;

# Compresion de las respuestas JSON (el catalogo de materias pesa bastante).
gzip            on;
gzip_min_length 512;
gzip_types      application/json text/plain;

# ---------------------------------------------------------------------------
# Upstreams dinamicos: Consul es el service registry.
# Algoritmo: round robin (por defecto). Alternativa: agregar `least_conn;`
# Health check activo: Consul pega a /health cada 5 s. Las replicas que no
# pasan no aparecen aqui. Health check pasivo de nginx como respaldo.
# ---------------------------------------------------------------------------
upstream materias_backend {
    zone materias_backend 64k;
{{- range service "materias" }}
    server {{ .Address }}:{{ .Port }} max_fails=2 fail_timeout=10s;
{{- else }}
    server 127.0.0.1:65535 down;
{{- end }}
}

upstream alumnos_backend {
    zone alumnos_backend 64k;
{{- range service "alumnos" }}
    server {{ .Address }}:{{ .Port }} max_fails=2 fail_timeout=10s;
{{- else }}
    server 127.0.0.1:65535 down;
{{- end }}
}

upstream inscripciones_backend {
    zone inscripciones_backend 64k;
{{- range service "inscripciones" }}
    server {{ .Address }}:{{ .Port }} max_fails=2 fail_timeout=10s;
{{- else }}
    server 127.0.0.1:65535 down;
{{- end }}
}

upstream notificaciones_backend {
    zone notificaciones_backend 64k;
{{- range service "notificaciones" }}
    server {{ .Address }}:{{ .Port }} max_fails=2 fail_timeout=10s;
{{- else }}
    server 127.0.0.1:65535 down;
{{- end }}
}
upstream espera_backend {
    zone espera_backend 64k;
{{- range service "espera" }}
    server {{ .Address }}:{{ .Port }} max_fails=2 fail_timeout=10s;
{{- else }}
    server 127.0.0.1:65535 down;
{{- end }}
}

upstream auditoria_backend {
    zone auditoria_backend 64k;
{{- range service "auditoria" }}
    server {{ .Address }}:{{ .Port }} max_fails=2 fail_timeout=10s;
{{- else }}
    server 127.0.0.1:65535 down;
{{- end }}
}

# ---------------------------------------------------------------------------
# Upstreams gRPC (puerto 9090 de cada replica). En Consul son los servicios
# "<nombre>-grpc", con health check del protocolo grpc.health.v1.
# ---------------------------------------------------------------------------
upstream materias_grpc {
    zone materias_grpc 64k;
{{- range service "materias-grpc" }}
    server {{ .Address }}:{{ .Port }} max_fails=2 fail_timeout=10s;
{{- else }}
    server 127.0.0.1:65535 down;
{{- end }}
}

upstream alumnos_grpc {
    zone alumnos_grpc 64k;
{{- range service "alumnos-grpc" }}
    server {{ .Address }}:{{ .Port }} max_fails=2 fail_timeout=10s;
{{- else }}
    server 127.0.0.1:65535 down;
{{- end }}
}

upstream inscripciones_grpc {
    zone inscripciones_grpc 64k;
{{- range service "inscripciones-grpc" }}
    server {{ .Address }}:{{ .Port }} max_fails=2 fail_timeout=10s;
{{- else }}
    server 127.0.0.1:65535 down;
{{- end }}
}

# ---------------------------------------------------------------------------
# Gateway gRPC (:9000, HTTP/2). Enruta por el nombre del servicio gRPC
# (primer segmento del path: /<paquete>.<Servicio>/<Metodo>) y reparte con
# round robin entre las replicas healthy. Lo usan grpcurl y los servicios
# entre si (inscripciones -> alumnos / materias).
# ---------------------------------------------------------------------------
server {
    listen 9000;
    http2 on;
    server_name _;

    grpc_connect_timeout 2s;
    grpc_send_timeout    30s;
    grpc_read_timeout    30s;

    # Failover: si la replica no conecta, se reintenta con otra.
    grpc_next_upstream         error timeout;
    grpc_next_upstream_tries   3;
    grpc_next_upstream_timeout 10s;

    grpc_set_header X-Real-IP    $remote_addr;
    grpc_set_header X-Request-Id $request_id;

    location /horarios.materias.v1.MateriasService/ {
        grpc_pass grpc://materias_grpc;
    }

    location /horarios.alumnos.v1.AlumnosService/ {
        grpc_pass grpc://alumnos_grpc;
    }

    location /horarios.inscripciones.v1.InscripcionesService/ {
        grpc_pass grpc://inscripciones_grpc;
    }

    # Cualquier otra ruta: gRPC UNIMPLEMENTED (12) en vez de un 404 HTTP.
    location / {
        add_header Content-Type  application/grpc always;
        add_header grpc-status   12 always;
        add_header grpc-message  "servicio no registrado en el gateway" always;
        return 204;
    }
}

server {
    listen 8000;
    server_name _;

    # --- Parametros comunes del proxy -------------------------------------
    proxy_http_version 1.1;
    proxy_set_header Connection "";                       # keep-alive hacia backends
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Id unico por peticion: viaja al backend y vuelve al cliente, para poder
    # seguir una misma peticion en los logs de nginx y de la replica.
    proxy_set_header X-Request-Id      $request_id;

    # --- Rate limiting (ver limit_req_zone arriba) ------------------------
    limit_req        zone=api_por_ip burst=100 nodelay;
    limit_req_status 429;
    error_page       429 = @demasiadas_peticiones;

    # Un backend caido (contenedor detenido) no debe colgar la peticion:
    proxy_connect_timeout 2s;
    proxy_send_timeout    30s;
    proxy_read_timeout    30s;

    # Failover: si la replica falla, se reintenta con la siguiente.
    # Por defecto nginx NO reintenta POST/DELETE no idempotentes, asi que una
    # alta de inscripcion nunca se duplica por un reintento.
    proxy_next_upstream         error timeout http_502 http_503 http_504;
    proxy_next_upstream_tries   3;
    proxy_next_upstream_timeout 10s;

    # --- Cabeceras CORS (el frontend en :3000 llama a :8000) --------------
    add_header Access-Control-Allow-Origin   "*" always;
    add_header Access-Control-Allow-Methods  "GET, POST, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers  "Content-Type" always;
    add_header Access-Control-Expose-Headers "X-Instance-Id, X-Upstream, X-Request-Id" always;
    # Replica de nginx que atendio (util para demostrar el balanceo)
    add_header X-Upstream $upstream_addr always;
    add_header X-Request-Id $request_id always;

    # --- Cabeceras de seguridad -------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;   # el navegador no adivina el tipo de contenido
    add_header X-Frame-Options        "DENY" always;      # nadie puede meter el sitio en un iframe
    add_header Referrer-Policy        "no-referrer" always;

    # --- Endpoints propios del gateway ------------------------------------
    # (sin rate limit: los usa el health check del contenedor y Prometheus)
    location = /heartbeat {
        default_type text/plain;
        return 200 "gateway alive";
    }

    # Metricas de nginx (conexiones activas, peticiones atendidas).
    # nginx_exporter lo traduce a formato Prometheus.
    location = /status {
        stub_status;
    }

    location @demasiadas_peticiones {
        default_type application/json;
        return 429 '{"error":"demasiadas peticiones, intenta de nuevo en un momento"}';
    }

    # --- Rutas hacia los servicios ----------------------------------------
    location /materias {
        if ($request_method = OPTIONS) { return 204; }
        proxy_pass http://materias_backend;
    }

    location /alumnos {
        if ($request_method = OPTIONS) { return 204; }
        proxy_pass http://alumnos_backend;
    }

    location /inscripciones {
        if ($request_method = OPTIONS) { return 204; }
        proxy_pass http://inscripciones_backend;
    }

    location /notificaciones {
        if ($request_method = OPTIONS) { return 204; }
        proxy_pass http://notificaciones_backend;
    }

    location /espera {
        if ($request_method = OPTIONS) { return 204; }
        proxy_pass http://espera_backend;
    }

    location /auditoria {
        if ($request_method = OPTIONS) { return 204; }
        proxy_pass http://auditoria_backend;
    }

    location / {
        default_type application/json;
        return 404 '{"error":"ruta no encontrada en el gateway"}';
    }
}
